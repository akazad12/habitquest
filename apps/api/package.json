{
  "name": "@habitquest/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "node --env-file=../../.env dist/server.js",
    "sessions:prune": "tsx --env-file=../../.env src/prune-sessions.ts"
  },
  "dependencies": {
    "@habitquest/shared": "*",
    "argon2": "^0.45.2",
    "cookie": "^1.1.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "tsx": "^4.0.0"
  }
}
