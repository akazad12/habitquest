# Template only; configure secrets in Render, never in Git.
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
WEB_ORIGIN=https://app.habitquest.example.invalid
TRUST_PROXY_HOPS=1
DB_POOL_MAX=10
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@database.example.invalid/habitquest?sslmode=verify-full
# Use direct migration connection and a separate role with DDL privileges.
MIGRATION_DATABASE_URL=postgresql://REPLACE_MIGRATOR:REPLACE_PASSWORD@database.example.invalid/habitquest?sslmode=verify-full
# Generate with: openssl rand -hex 32; store only in platform secrets.
RATE_LIMIT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Optional PEM CA if your managed provider does not chain to system trust.
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
