DATABASE_URL=postgresql://habitquest:local_dev_only@localhost:5432/habitquest?schema=public
POSTGRES_USER=habitquest
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=habitquest
PORT=3001
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development

# Production requires NODE_ENV=production, an HTTPS WEB_ORIGIN, and HTTPS API hosting.
# Session cookies use a random token; no signing secret or client-side token is required.

# Optional operational defaults (production requires explicit configuration; see deploy/).
DB_POOL_MAX=10
TRUST_PROXY_HOPS=0
# RATE_LIMIT_SECRET is required in production only; generate randomly in platform secrets.
# MIGRATION_DATABASE_URL may use a separate direct migration role.
